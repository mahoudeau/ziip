# Copy this file to .env and fill in your FTP credentials for the
# lab.mathieu.dev/ziip deploy. The .env file is gitignored.

FTP_HOST=ftp.example.com
FTP_USER=your-ftp-user
FTP_PASS=your-ftp-password

# Remote directory on the lab host that maps to lab.mathieu.dev/ziip
FTP_LAB_DIR=/www/lab.mathieu.dev/ziip
